{
  "name": "oauth-pkce-demo",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "test:frontend": "pnpm --filter frontend test",
    "test:backend": "pnpm --filter backend test",
    "test:e2e:frontend": "pnpm --filter frontend e2e",
    "test:e2e:backend": "pnpm --filter backend test:e2e",
    "lint:frontend": "pnpm --filter frontend lint",
    "lint:backend": "pnpm --filter backend lint",
    "docker:up": "docker compose --profile full up --build",
    "docker:redis": "docker compose up -d redis",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
